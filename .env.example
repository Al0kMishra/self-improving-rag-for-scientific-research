ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

ARXIV_CATEGORIES=["cs.AI","cs.LG","cs.CL","cs.CV","cs.NE","stat.ML"]
ARXIV_MAX_RESULTS=20
ARXIV_RECENCY_DAYS=1095
ARXIV_REQUEST_DELAY_SECONDS=3
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_TIMEOUT_SECONDS=30
ARXIV_MAX_ATTEMPTS=5
ARXIV_BACKOFF_SECONDS=10
ARXIV_CACHE_TTL_HOURS=24
ARXIV_MIN_RESULTS=5
ARXIV_MAX_KEYWORDS=5

MAX_PDF_PAGES=30
PDF_MAX_PAPERS_PER_QUERY=8
PDF_MAX_BYTES=25000000
PDF_DOWNLOAD_DELAY_SECONDS=1
MIN_EXTRACTED_CHARS=2000
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=
CHROMA_COLLECTION=chunks
RETRIEVAL_CANDIDATE_POOL=40
RETRIEVAL_TOP_K=8

LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_EFFORT=
LLM_FALLBACKS=true
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=300
EVALUATOR_PROVIDER=
EVALUATOR_MODEL=
EVALUATOR_API_KEY=
EVALUATOR_BASE_URL=

ALPHA_INIT=0.70
BETA_INIT=0.15
GAMMA_INIT=0.15
WEIGHT_MIN=0.05
WEIGHT_MAX=0.90
WEIGHT_LEARNING_RATE=0.10
ADAPTATION_MIN_LABELS=3
RECENCY_HALF_LIFE_DAYS=365
MAX_CHUNKS_PER_PAPER=3
FEEDBACK_PRIOR_STRENGTH=2
FEEDBACK_SIMILARITY_THRESHOLD=0.3
